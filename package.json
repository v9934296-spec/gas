{
  "name": "rap-lab",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "test": "node --test --experimental-default-type=module",
    "validate:phase0": "node --experimental-default-type=module ./scripts/runPhase0Validation.mjs",
